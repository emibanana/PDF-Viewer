{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF Viewer",
  "mainBinaryName": "PDF-Viewer",
  "version": "0.1.0",
  "identifier": "app.pdfviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx vite --mode studio",
    "beforeBuildCommand": "npx vite build --mode studio"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "publisher": "PDF Viewer",
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/windows/app.ico"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}

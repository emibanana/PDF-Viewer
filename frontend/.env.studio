###############################################################################
# PDF Viewer (studio) build: layered on top of .env when running
# `vite --mode studio`. Blanks every third-party service key inherited from
# .env so the app never talks to Stirling's analytics, billing or auth.
###############################################################################

VITE_API_BASE_URL=/
VITE_DESKTOP_BACKEND_URL=
VITE_INCLUDE_PORTAL=false

VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_APP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
VITE_FEEDBACK_URL=
VITE_CALENDLY_URL=
